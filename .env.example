# Copy this file to .env and fill it in. The app runs with NO keys at all in
# mock mode, so you can see the whole thing working before signing up for
# anything.

PORT=3000

# Password for the operator console. Change this before the app touches a
# network — anyone with it can put text on the screen.
OPERATOR_PASSWORD=change-me

# --- Speech to text (Arabic) ----------------------------------------
# Deepgram: https://console.deepgram.com  — $200 free credit, no card.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ar = general Arabic. Also ar-EG, ar-SA, ar-MA, ar-LV. A khutbah is mostly
# Modern Standard Arabic, so start with "ar" and only change it if the
# informal portions test better on a regional model.
ARABIC_DIALECT=ar

# --- Translation ----------------------------------------------------
# claude | deepl | google | none
#
# The app falls back through whichever providers have keys, so setting two
# means a failure on one doesn't put Arabic on the screen.
#
# "claude" is recommended: Arabic to French/English at sermon register is
# where generic machine translation is weakest, and both languages come back
# from one call.
#
# "none" passes Arabic straight through — useful for confirming speech
# recognition works before adding a translation key.
TRANSLATE_PROVIDER=claude

# https://console.anthropic.com  (needs credits — there is no free tier)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# https://www.deepl.com/pro-api  (free tier: 500k characters/month, no card)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

GOOGLE_TRANSLATE_API_KEY=
